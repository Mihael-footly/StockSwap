# Defaults are a safe, read-only MAINNET deployment. Keep execution disabled until the deployment is verified.
CHAIN_ID=4663
RPC_URL=https://rpc.mainnet.chain.robinhood.com
# Optional second provider. Use dedicated provider endpoints in production.
RPC_FALLBACK_URL=
EXPLORER_URL=https://robinhoodchain.blockscout.com
EXECUTION_ENABLED=false
# Required to persist quotes/swaps and enable execution. Server secret; never use NEXT_PUBLIC_ for this key.
SUPABASE_URL=https://ugjxpazegfxkbmfsihyj.supabase.co
SUPABASE_SECRET_KEY=
# Legacy fallback while rotating keys (optional).
SUPABASE_SERVICE_ROLE_KEY=
# Required for scheduled reconciliation. Server secret, at least 32 random bytes.
CRON_SECRET=
# Optional: WalletConnect project ID for mobile QR/deep linking; public identifier.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
